<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Activate Your Account</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
    body { margin: 0; padding: 0; width: 100% !important; height: 100% !important; background-color: #f4f5f7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }

    .code-box {
      letter-spacing: 6px;
      font-size: 32px;
      font-weight: 700;
      color: #1a1a2e;
      background-color: #f0f1fb;
      border: 1px dashed #6c63ff;
      border-radius: 8px;
      padding: 18px 24px;
      display: inline-block;
    }

    @media screen and (max-width: 600px) {
      .email-container { width: 100% !important; }
      .content-padding { padding: 24px !important; }
      .code-box { font-size: 24px !important; letter-spacing: 4px !important; padding: 14px 16px !important; }
    }

    @media (prefers-color-scheme: dark) {
      .bg-body { background-color: #17171f !important; }
      .bg-card { background-color: #1f1f2b !important; }
      .text-primary { color: #f5f5f7 !important; }
      .text-secondary { color: #b7b7c2 !important; }
    }
  </style>
</head>
<body class="bg-body" style="margin:0; padding:0; background-color:#f4f5f7;">

  <!-- Preheader (hidden preview text) -->
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
    Your activation code is <%= activationCode %>. It expires in <%= expiryMinutes %> minutes.
  </div>

  <center class="bg-body" style="width:100%; background-color:#f4f5f7;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:600px; margin:0 auto;" class="email-container">

      <!-- Logo / Header -->
      <tr>
        <td style="padding: 32px 24px 16px; text-align:center;">
          <% if (typeof logoUrl !== 'undefined' && logoUrl) { %>
            <img src="<%= logoUrl %>" alt="<%= appName %>" width="140" style="display:block; margin:0 auto;">
          <% } else { %>
            <span style="font-size:20px; font-weight:700; color:#1a1a2e;"><%= appName %></span>
          <% } %>
        </td>
      </tr>

      <!-- Card -->
      <tr>
        <td class="bg-card content-padding" style="background-color:#ffffff; border-radius:12px; padding:40px; box-shadow:0 2px 8px rgba(0,0,0,0.05);">
          <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td style="text-align:center;">
                <h1 class="text-primary" style="margin:0 0 12px; font-size:22px; color:#1a1a2e; font-weight:700;">
                  Confirm your email address
                </h1>
                <p class="text-secondary" style="margin:0 0 28px; font-size:15px; line-height:1.6; color:#5c5c6e;">
                  Hi <%= userName %>, use the code below to activate your <%= appName %> account.
                  This code will expire in <strong><%= expiryMinutes %> minutes</strong>.
                </p>

                <div class="code-box"><%= activationCode %></div>

                <p class="text-secondary" style="margin:28px 0 0; font-size:14px; line-height:1.6; color:#5c5c6e;">
                  Or click the button below to activate automatically:
                </p>

                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px auto 0;">
                  <tr>
                    <td style="border-radius:8px; background-color:#6c63ff;">
                      <a href="<%= activationUrl %>"
                         target="_blank"
                         style="display:inline-block; padding:14px 32px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:8px;">
                        Activate Account
                      </a>
                    </td>
                  </tr>
                </table>

                <p class="text-secondary" style="margin:28px 0 0; font-size:13px; line-height:1.6; color:#9a9aa8;">
                  Didn't request this? You can safely ignore this email.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>

      <!-- Footer -->
      <tr>
        <td style="padding: 24px 24px 40px; text-align:center;">
          <p style="margin:0 0 6px; font-size:12px; color:#9a9aa8;">
            &copy; <%= new Date().getFullYear() %> <%= appName %>. All rights reserved.
          </p>
          <% if (typeof supportEmail !== 'undefined' && supportEmail) { %>
            <p style="margin:0; font-size:12px; color:#9a9aa8;">
              Need help? Contact us at <a href="mailto:<%= supportEmail %>" style="color:#6c63ff; text-decoration:none;"><%= supportEmail %></a>
            </p>
          <% } %>
        </td>
      </tr>

    </table>
  </center>
</body>
</html>
